# Copy to .env for local development; nothing here is ever committed. The
# server gets its settings from compose.prod.yaml and GitHub secrets instead.
#
#   npm run db:up       Postgres on localhost:5434, migrations applied
#   npm run dev:api     the server on :3002, reading this file
#   npm run dev         the site on :5173, which forwards /api and /ws to :3002

# Read by the server.
DATABASE_URL=postgres://minigames:minigames@localhost:5434/minigames
APP_URL=http://localhost:5173
# The IrmaHS Labs account service (irmahs-labs/auth), run locally on :3001.
AUTH_INTERNAL_URL=http://localhost:3001
PORT=3002

# Read by the site at build time. Without it, sign-in goes to
# https://auth.irmahs.dev, whose cookie localhost never receives.
VITE_AUTH_URL=http://localhost:3001
